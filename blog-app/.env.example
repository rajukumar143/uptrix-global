# ==============================================================================
# Environment Variables for Next.js Blog & Admin Panel
# Copy this file to .env.local for local development.
# On Hostinger, configure these variables in the Node.js Hosting Dashboard.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Configuration (SERVER ONLY - NEVER expose with NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJh...your_supabase_service_role_secret_key_here

# ------------------------------------------------------------------------------
# Admin Authentication (NO plaintext password in code or env)
# Generate password hash with: node scripts/hash-password.js your_password
# ------------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2a$12$e0NZB...your_bcrypt_hash_here

# ------------------------------------------------------------------------------
# JWT Session Secret (Must be at least 32 characters long)
# Generate with: openssl rand -base64 32
# ------------------------------------------------------------------------------
SESSION_SECRET=your_super_secret_session_key_minimum_32_characters_long

# ------------------------------------------------------------------------------
# Upstash Redis Rate Limiting (10 login requests per minute per IP)
# Sign up free at https://upstash.com
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# ------------------------------------------------------------------------------
# Optional Public Site URL (Used for canonical links, sitemaps, and og:images)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
