# Copy this to .env.local in the project folder on the server and fill it in.
#   cp deploy/env.example .env.local && nano .env.local

# Your live web address (no slash at the end)
SITE_URL=https://yourdomain.com

# Admin dashboard login (/admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-long-password-here
# 32+ random characters. Make one with:  openssl rand -base64 48
ADMIN_SESSION_SECRET=paste-random-text-here

# Where the dashboard saves your website text. Keep it OUTSIDE the project folder
# so code updates can never overwrite it.
CONTENT_DIR=/var/www/uptrix-data/content
