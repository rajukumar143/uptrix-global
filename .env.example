# -----------------------------------------------------------------------------
# Uptrix Global - Single Unified Environment Configuration (.env.local)
# Used for BOTH Public Website & Admin Dashboard (/admin)
# -----------------------------------------------------------------------------

# Website URL (e.g. http://localhost:3000 for local development, or https://uptrixglobal.com in production)
SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# PostgreSQL Database Configuration
# -----------------------------------------------------------------------------
DB_HOST=187.77.188.152
DB_PORT=5432
DB_NAME=uptrixglobal_db
DB_USER=uptrixglobal_user_db
DB_PASSWORD=your-db-password
DB_SCHEMA=public

# -----------------------------------------------------------------------------
# Admin Dashboard Authentication (/admin)
# -----------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-admin-password
# 32+ character random key for session tokens (e.g., openssl rand -base64 48)
ADMIN_SESSION_SECRET=your-random-32-plus-character-secret-key-here

# -----------------------------------------------------------------------------
# Content Storage (Optional - defaults to ./content)
# -----------------------------------------------------------------------------
CONTENT_DIR=./content

# -----------------------------------------------------------------------------
# Analytics & Security (Optional)
# -----------------------------------------------------------------------------
# Google Analytics 4 ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA4_ID=

# Cloudflare Turnstile Captcha
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
