# -----------------------------------------------------------------------------
# Uptrix Global - Environment Configuration
# Copy this file to .env.local for local development or on your production server:
#   cp .env.example .env.local
# -----------------------------------------------------------------------------

# =============================================================================
# 1. APPLICATION MODE & URLS
# =============================================================================
# APP_MODE options:
#   'all'    - (Default) Runs both public website and admin dashboard together
#   'public' - Runs only the public website
#   'admin'  - Runs only the admin portal
APP_MODE=all

# Your website domain (no trailing slash)
SITE_URL=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3000

# Admin API URL (used only when running separate public/admin deployments)
API_URL=http://localhost:3000

# =============================================================================
# 2. CONTENT & UPLOAD DIRECTORIES
# =============================================================================
# Directory where site content/JSON files are stored
# In production, set outside the project folder so updates don't overwrite it
CONTENT_DIR=./content
PUBLIC_HTML_DIR=./public

# =============================================================================
# 3. ADMIN AUTHENTICATION (/admin)
# =============================================================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-admin-password

# Generate with: openssl rand -base64 48 (must be 32+ characters)
ADMIN_SESSION_SECRET=your-random-32-plus-character-secret-key-here

# Secret key for revalidation and API communication between public & admin
ADMIN_API_SECRET=your-internal-api-secret

# =============================================================================
# 4. POSTGRESQL DATABASE CONFIGURATION
# =============================================================================
DB_HOST=187.77.188.152
DB_PORT=5432
DB_NAME=uptrixglobal_db
DB_USER=uptrixglobal_user_db
DB_PASSWORD=your-db-password
DB_SCHEMA=public

# =============================================================================
# 5. SECURITY & CAPTCHA (Cloudflare Turnstile)
# =============================================================================
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# =============================================================================
# 6. ANALYTICS
# =============================================================================
# Google Analytics 4 ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA4_ID=
